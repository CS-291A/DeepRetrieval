# Template for code/.env. scripts/setup_pod.sh writes the real file (mode 600); to make
# it by hand: cp .env.example .env && chmod 600 .env, then fill in values.
# scripts/common.sh (sourced by every launcher) loads it; a variable that is already set
# in the environment wins over the value here. Format: KEY='value' (single quotes, no
# quote characters or line breaks inside); no $, backticks or command substitution.

# --- secrets (all optional; leave out what you do not have) ---
# NCBI E-utilities key: PubMed rewards get 10 requests/s instead of the keyless 3.
#PUBMED_API_KEY=''
# Weights & Biases (launchers use trainer.logger=['wandb']; or export WANDB_MODE=offline).
#WANDB_API_KEY=''
# Hugging Face token, needed for gated models such as meta-llama/Llama-3.2-3B-Instruct.
#HF_TOKEN=''

# --- settings (setup_pod.sh writes these values for a Runpod volume at /workspace) ---
# Dataset root; launchers read "$DEEPRETRIEVAL_DATA_DIR/search_engine/...". Default: code/data.
#DEEPRETRIEVAL_DATA_DIR='/workspace/data'
#HF_HOME='/workspace/.cache/huggingface'
#UV_CACHE_DIR='/workspace/.cache/uv'
# uv-managed CPython; must be on the volume because the venv links to it.
#UV_PYTHON_INSTALL_DIR='/workspace/.cache/uv-python'
# Keep at 0: under `uv run`, Ray otherwise ships a .gitignore-filtered copy of the
# working dir to workers, which then cannot see data/ (GPU smoke test finding S2).
#RAY_ENABLE_UV_RUN_RUNTIME_ENV='0'
#VERL_LOGGING_LEVEL='INFO'
